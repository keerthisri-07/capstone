# ============================================================
# AI Women Safety Companion — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="SURAKSHA AI Platform"
APP_ENV=development          # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database ---
MONGODB_URL=mongodb://localhost:27017
DB_NAME=suraksha_db

# --- JWT Authentication ---
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI APIs (Optional — app works in mock mode without these) ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
AI_PROVIDER=gemini    # gemini | openai | mock

# --- LangSmith (Optional — for AI monitoring) ---
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=suraksha-platform
LANGCHAIN_TRACING_V2=false

# --- ChromaDB (Vector Database) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_ENABLED=false    # set true when ChromaDB is running

# --- n8n Automation ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_ENABLED=false         # set true when n8n is running

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Email (for OTP / Notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_ENABLED=false

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_AI=20/minute

# --- Demo Mode ---
DEMO_MODE=true            # pre-seeds demo data on startup
DEMO_ADMIN_EMAIL=admin@suraksha.ai
DEMO_ADMIN_PASSWORD=demo123
